{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      "PATH": "${env:LOCALAPPDATA}\\nsh\\bin;${env:USERPROFILE}\\.cargo\\bin;${env:USERPROFILE}\\tools\\msys64\\mingw64\\bin;${env:PATH}",
      "CARGO_HOME": "${workspaceFolder}\\.tools\\cargo-home",
      "RUSTC_STAGE": "1",
      "TMP": "${workspaceFolder}\\.cargo\\tmp",
      "TEMP": "${workspaceFolder}\\.cargo\\tmp"
    }
  },
  "tasks": [
    {
      "label": "开发：nsh dev（官方入口）",
      "detail": "nsh dev .：官方开发入口，本机原生宿主 + TSX 热重载；按端口自动接管旧会话，无需手动清理，Ctrl+C 结束。",
      "type": "shell",
      "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Set-Location '${workspaceFolder}'; nsh dev ."
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "开发：Web 预览（nsh run --target web）",
      "detail": "nsh run . --target web：浏览器里的 Web 运行时，仅用于快速看布局；日常开发用「开发：nsh dev（官方入口）」。",
      "type": "shell",
      "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Set-Location '${workspaceFolder}'; nsh run . --target web"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "检查：nsh check（官方）",
      "detail": "nsh check .：官方类型检查，先 cargo check native crate，再用 nsh 内置的 TypeScript 7 检查 TSX。",
      "type": "shell",
      "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Set-Location '${workspaceFolder}'; nsh check ."
      ],
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "检查：TypeScript（npm run typecheck）",
      "detail": "npm run typecheck：用仓库 node_modules 里的 tsc 检查 TSX（首次需 npm install）；nsh check 不可用时的备用门禁。",
      "type": "shell",
      "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Set-Location '${workspaceFolder}'; npm run typecheck"
      ],
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "测试：nsh test（native + TSX）",
      "detail": "先清空 .tmp/test-data，再 nsh test .：native cargo test + TSX headless UI 测试；MEND_DATA_DIR 指向该目录，测试库与真实库隔离。",
      "type": "shell",
      "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Set-Location '${workspaceFolder}'; $env:MEND_DATA_DIR = '${workspaceFolder}\\.tmp\\test-data'; Remove-Item -Recurse -Force $env:MEND_DATA_DIR -ErrorAction SilentlyContinue; nsh test ."
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "测试：Rust 核心（cargo test）",
      "detail": "cargo test --manifest-path core/Cargo.toml：加密、SQLite、备份、迁移等核心测试，不依赖 nsh/GUI。",
      "type": "shell",
      "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Set-Location '${workspaceFolder}'; cargo test --manifest-path core/Cargo.toml"
      ],
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "打包：Windows（nsh package）",
      "detail": "先跑 nsh check，再 nsh package . --target windows：产物在 .nsh/out（Mend/ 含 Mend.exe、Mend.zip、带版本的更新压缩包、Mend.iss）；装有 Inno Setup 6 时另有 setup.exe。",
      "type": "shell",
      "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Set-Location '${workspaceFolder}'; nsh package . --target windows"
      ],
      "dependsOn": ["检查：nsh check（官方）"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "格式化：cargo fmt + Prettier",
      "detail": "cargo fmt（core + native）就地格式化 Rust，Prettier 就地格式化 TSX / JSON；不改 docs/。",
      "type": "shell",
      "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Set-Location '${workspaceFolder}'; cargo fmt --manifest-path core/Cargo.toml; cargo fmt --manifest-path native/Cargo.toml; npx prettier --write \"App.tsx\" \"App.test.tsx\" \"components/**/*.tsx\" \"screens/**/*.tsx\" \"lib/**/*.ts\" \"nsh.json\" \"theme.json\" \"tsconfig.json\" \"locales/*.json\""
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "清理：构建产物与临时文件",
      "detail": "删除 .nsh/out、.tmp/test-data 与 .cargo/tmp 里的 gcc 临时残留（保留 .gitkeep）；保留 .nsh/types、依赖缓存与真实库。",
      "type": "shell",
      "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Set-Location '${workspaceFolder}'; Remove-Item -Recurse -Force '.nsh/out','.tmp/test-data' -ErrorAction SilentlyContinue; Get-ChildItem '.cargo/tmp' -Force -ErrorAction SilentlyContinue | Where-Object { $_.Name -ne '.gitkeep' } | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue; Write-Host '已清理 .nsh/out、.tmp/test-data 与 .cargo/tmp 残留（保留 .gitkeep）' -ForegroundColor Green"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "一键验证：check + typecheck + 测试",
      "detail": "按顺序跑 nsh check、npm run typecheck、nsh test 与核心 cargo test；全部通过可作为提交前门禁。",
      "dependsOrder": "sequence",
      "dependsOn": [
        "检查：nsh check（官方）",
        "检查：TypeScript（npm run typecheck）",
        "测试：nsh test（native + TSX）",
        "测试：Rust 核心（cargo test）"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
