{
  "name": "mend",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "description": "Local offline encrypted password manager (Tauri + Vue 3 + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
