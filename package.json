{
  "name": "mend",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Local offline encrypted password manager (Native Shell / TSX + Rust)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "nsh dev .",
    "build": "nsh build .",
    "package": "nsh package . --target windows",
    "test": "nsh test .",
    "check": "nsh check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.6.3"
  }
}
