# --- Native Shell generated / local toolchain ---
/.nsh/
/.tools/
/target/
**/target/
*.nshpkg
*.mendbak

# --- Local scratch / test data (never the Cargo temp dir; that lives in .cargo/tmp) ---
/.tmp/

# --- Cargo build-script temp dir (see .cargo/config.toml) ---
# Keep the placeholder so the directory exists in a fresh clone; ignore its contents.
/.cargo/tmp/*
!/.cargo/tmp/.gitkeep

# --- Node dev tooling (type check / format only) ---
node_modules/
dist/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Rust ---
*.rs.bk
Cargo.lock.bak

# --- Signing secrets (nsh keys; keep offline / in Actions secrets) ---
keys/*.secret
keys/*.key

# --- Private local notes / logs / offline keys ---
/local/
/.workbuddy/
/.memsearch/

# --- App data / sensitive vault files ---
*.db
*.sqlite
*.sqlite3
*.vault
data/
# .env

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.iml
.DS_Store
Thumbs.db
desktop.ini