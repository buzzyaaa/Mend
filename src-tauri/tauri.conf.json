{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mend",
  "version": "0.2.0",
  "identifier": "com.mend.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mend",
        "width": 1040,
        "height": 680,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "shortDescription": "Local offline encrypted password manager",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
  "updater": {
    "active": false,
    "endpoints": [],
    "pubkey": "",
    "dialog": true,
    "installerArgs": [],
    "pubkeyProvider": "app"
  }
